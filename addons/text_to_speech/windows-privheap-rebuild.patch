diff --git a/src/cst_private_heap.c b/src/cst_private_heap.c
new file mode 100644
index 0000000..f65aa6b
--- /dev/null
+++ b/src/cst_private_heap.c
@@ -0,0 +1,60 @@
+/* Private-heap allocator for flite (Windows).
+ *
+ * Built with -DCST_USER_MALLOC on the flite side, which drops flite's default
+ * cst_safe_alloc/cst_safe_calloc/cst_safe_realloc/cst_free (all thin wrappers
+ * over the C runtime) and expects the host to provide them. We back them with
+ * a dedicated Win32 heap (HeapCreate) instead of the CRT heap.
+ *
+ * WHY: msvcrt and ucrtbase both allocate from the PROCESS DEFAULT heap on
+ * modern Windows, so a MinGW/msvcrt GDExtension shares one RtlHeap with the
+ * host engine, every other extension, and GPU driver user-mode code. Crash
+ * forensics on CYBERSUNDAY playtests (2026-08-28/29) showed heap-corruption
+ * fail-fasts DETECTED at this extension's frees while the extension's own
+ * allocation behavior audits clean (72M-allocation guarded stress, all voices,
+ * real game text). A private heap isolates flite completely: its blocks cannot
+ * neighbor foreign allocations, so foreign overflows cannot corrupt TTS data
+ * and TTS frees cannot be the process-heap corruption detector that kills the
+ * game. Non-Windows builds keep flite's stock allocator (see the #else).
+ *
+ * All flite allocation goes through these four functions (cst_alloc/cst_free
+ * macros); flite never frees these pointers with raw free() nor frees raw
+ * malloc() pointers with cst_free (audited against the pinned flite tree).
+ */
+#ifdef _WIN32
+
+#include <windows.h>
+#include <string.h>
+
+static HANDLE flite_heap(void) {
+    /* Created on first use; single-threaded use in practice (all extension
+     * calls are synchronous main-thread), but HeapCreate(0,...) is serialized
+     * anyway, so a future threaded caller stays safe. Never destroyed: voices
+     * live for the whole process, exactly like the engine's own singletons. */
+    static HANDLE h = NULL;
+    if (h == NULL)
+        h = HeapCreate(0, 1 << 20, 0);  /* growable, 1 MB initial reserve */
+    return h;
+}
+
+void *cst_safe_alloc(int size) {
+    if (size < 0) return NULL;
+    if (size == 0) size = 1;
+    return HeapAlloc(flite_heap(), HEAP_ZERO_MEMORY, (SIZE_T)size);
+}
+
+void *cst_safe_calloc(int size) {
+    return cst_safe_alloc(size);
+}
+
+void *cst_safe_realloc(void *p, int size) {
+    if (p == NULL) return cst_safe_alloc(size);
+    if (size <= 0) size = 1;
+    return HeapReAlloc(flite_heap(), HEAP_ZERO_MEMORY, p, (SIZE_T)size);
+}
+
+void cst_free(void *p) {
+    if (p != NULL)
+        HeapFree(flite_heap(), 0, p);
+}
+
+#endif /* _WIN32 */
