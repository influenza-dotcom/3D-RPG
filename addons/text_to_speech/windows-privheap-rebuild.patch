-TextToSpeech::TextToSpeech() {
-    UtilityFunctions::print("TTS constructor");
-
+// Process-wide cache of loaded voices, keyed by file path. Voices are loaded at
+// most ONCE per process and never deleted: every game engine instance asking
+// for the same .flitevox shares one cst_voice. This removes delete_voice() --
+// and with it flite's entire cg_db/cart/features teardown -- from the runtime
+// path entirely (its free counts are derived from voice-file fields read
+// independently of the arrays they free, a fragility not worth exercising
+// mid-game), and makes repeat voice switches instant instead of a 6-12 MB
+// reload. Bounded by the shipped voice set; all calls are main-thread.
+static std::map<std::string, cst_voice *> g_voice_cache;
+
+// flite's language list is a global with a fixed capacity; register the
+// language exactly once per process instead of once per TextToSpeech instance
+// (the game builds up to ~16 instances across its speech pools).
+static void ensure_flite_ready() {
+    static bool inited = false;
+    if (inited)
+        return;
+    inited = true;
     flite_init();
     flite_add_lang("eng", usenglish_init, cmulex_init);
     flite_add_lang("usenglish", usenglish_init, cmulex_init);
+}
+
+TextToSpeech::TextToSpeech() {
+    UtilityFunctions::print("TTS constructor");
+
+    ensure_flite_ready();
 
     current_voice = nullptr;
 }
 
 TextToSpeech::~TextToSpeech() {
     UtilityFunctions::print("TTS destructor");
+    // current_voice is owned by g_voice_cache -- never deleted here.
 }
 
