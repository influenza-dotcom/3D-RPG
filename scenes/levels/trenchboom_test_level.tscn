[sub_resource type="Resource" id="Resource_8odkv"]
script = ExtResource("27_888rm")
text = "I have some questions."
target = 2
metadata/_custom_type_script = "uid://csb55tjjecvsy"

[sub_resource type="Resource" id="Resource_blif2"]
script = ExtResource("26_loova")
text = "I'm trying to withdraw some Zorkmids. ... Buzz off, scab!"
choices = Array[ExtResource("27_888rm")]([SubResource("Resource_jn032"), SubResource("Resource_8odkv")])
metadata/_custom_type_script = "uid://cjonbsqr2gwyj"

[sub_resource type="Resource" id="Resource_loova"]
script = ExtResource("27_888rm")
text = "I'm new to this city."
metadata/_custom_type_script = "uid://csb55tjjecvsy"

[sub_resource type="Resource" id="Resource_888rm"]
script = ExtResource("27_888rm")
text = "I'm no kid, old man."
metadata/_custom_type_script = "uid://csb55tjjecvsy"

[sub_resource type="Resource" id="Resource_42wi0"]
script = ExtResource("26_loova")
text = "You deaf or just dumb, kid? Zorkmids are the currency of Headshot City."
choices = Array[ExtResource("27_888rm")]([SubResource("Resource_loova"), SubResource("Resource_888rm")])
metadata/_custom_type_script = "uid://cjonbsqr2gwyj"

[sub_resource type="Resource" id="Resource_rxf23"]
script = ExtResource("27_888rm")
text = "Relax! I can help you out, buddy."
target = 3
target_on_fail = 2
required_stat = &"streetwise"
required_value = 2
metadata/_custom_type_script = "uid://csb55tjjecvsy"

[sub_resource type="Resource" id="Resource_e35lk"]
script = ExtResource("26_loova")
text = "I haven't got any more time left for you, I need to withdraw some Zorkmids or I'm toast!"
choices = Array[ExtResource("27_888rm")]([SubResource("Resource_rxf23")])
metadata/_custom_type_script = "uid://cjonbsqr2gwyj"

[sub_resource type="Resource" id="Resource_5ulgd"]
script = ExtResource("26_loova")
text = "Hm, maybe I can trust you. People from the Red Dot District want me dead unless I can pay them. Can you help me make fifty-six Zorkmids?"
