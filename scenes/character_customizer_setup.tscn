[gd_scene load_steps=8 format=3]

; AUTHORING AID for the player character customizer — open this scene to TUNE a head's placement the same way you
; tune an NPC. The BodyModelSwap below is the @tool component NPCs use, pre-configured with the SHIPPED player rig
; (standard torso + shared arms/legs). To fit a head:
;   1) Select the BodyModelSwap node.
;   2) Set `head_model` to the .glb you want to fit (headblue / head / female_head / head_chrysalis).
;   3) Dial head_scale / head_position / head_rotation until the head sits on the neck — it previews LIVE.
;   4) Copy those three values into that head's CharacterPartOption (scale / position / rotation) in
;      resources/characters/PlayerAppearanceCatalog.tres (or CharacterAppearanceCatalog.default() in code).
; This scene is authoring-only; nothing loads it at runtime. (uids are reused from scenes/enemies/enemy.tscn.)

[ext_resource type="Script" uid="uid://bms5grrivunn4" path="res://scripts/components/body_model_swap.gd" id="1_swap"]
[ext_resource type="PackedScene" uid="uid://cjmrxe3tgvrb1" path="res://scenes/torso.tscn" id="2_torso"]
[ext_resource type="PackedScene" uid="uid://dpt6c1qr124v2" path="res://assets/models/headblue.glb" id="3_head"]
[ext_resource type="Texture2D" uid="uid://dou4ysmynvd42" path="res://scenes/stupidbody_Material Base Color.png" id="4_btex"]
[ext_resource type="PackedScene" uid="uid://6afrg0aexivb" path="res://assets/models/arm.blend" id="5_arm"]
[ext_resource type="Texture2D" uid="uid://mjggx30y4vmv" path="res://assets/models/headblue_Material Base Color.png" id="6_htex"]
[ext_resource type="PackedScene" uid="uid://qt4vyr3d5u2j" path="res://assets/models/leg.blend" id="7_leg"]

[node name="CharacterCustomizerSetup" type="Node3D"]

[node name="BodyModelSwap" type="Node3D" parent="."]
