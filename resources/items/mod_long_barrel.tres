[gd_resource type="Resource" script_class="Item" format=3 uid="uid://d1p6qc1myns84"]

[ext_resource type="Script" uid="uid://bsoytr2a8787u" path="res://scripts/items/item.gd" id="1_item"]
[ext_resource type="Script" uid="uid://btl141eq2n8qa" path="res://scripts/items/weapon_mod.gd" id="2_mod"]
[ext_resource type="Script" uid="uid://c5gtrmu67noes" path="res://scripts/items/weapon_stat_delta.gd" id="3_delta"]

[sub_resource type="Resource" id="Delta_range"]
script = ExtResource("3_delta")
property = &"effective_range"
amount = 8.0

[sub_resource type="Resource" id="Delta_spread"]
script = ExtResource("3_delta")
property = &"pellet_spread"
op = 2
amount = 0.75

[sub_resource type="Resource" id="Delta_move"]
script = ExtResource("3_delta")
property = &"move_speed_multiplier"
op = 2
amount = 0.96

[sub_resource type="Resource" id="Delta_sway"]
script = ExtResource("3_delta")
property = &"hip_sway_mult"
op = 2
amount = 1.1

[sub_resource type="Resource" id="Mod_long_barrel"]
script = ExtResource("2_mod")
slot = 1
fits_weapon_ids = Array[StringName]([&"pistol", &"smg", &"sniper"])
deltas = Array[ExtResource("3_delta")]([SubResource("Delta_range"), SubResource("Delta_spread"), SubResource("Delta_move"), SubResource("Delta_sway")])

[resource]
script = ExtResource("1_item")
id = &"mod_long_barrel"
display_name = "[PH] Long Barrel"
description = "[PH] Twelve more inches of rifled steel, threaded on and timed by hand. Reaches further and groups tighter, and you feel every one of those inches on a long walk."
max_stack = 10
value = 60.0
weapon_mod = SubResource("Mod_long_barrel")
grid_width = 2
