script = ExtResource("1")
id = &"zorkmids"
display_name = "Zorkmids"
description = "Cold, hard coin. Your whole purse rides here as one stack — drag it around the grid, or right-click to spill the lot on the ground as a pouch you (or anyone) can grab. One coin is a hundredth of a zorkmid, so the stack counts in fractions."
