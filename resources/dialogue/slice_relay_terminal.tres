[gd_resource type="Resource" script_class="DialogueResource" format=3 uid="uid://brrsgshq2nrtg"]

[ext_resource type="Script" uid="uid://cjonbsqr2gwyj" path="res://scripts/dialogue/dialogue_line.gd" id="1_line"]
[ext_resource type="Script" uid="uid://csb55tjjecvsy" path="res://scripts/dialogue/dialogue_choice.gd" id="2_choice"]
[ext_resource type="Script" uid="uid://brjt78ou6p8py" path="res://scripts/dialogue/dialogue_resource.gd" id="3_dialogue"]

[sub_resource type="Resource" id="Choice_transmit"]
script = ExtResource("2_choice")
target = 1
required_item_id = &"slice_package"
required_quest_id = &"recover_package"
required_quest_state = 1
complete_quest_id = &"recover_package"
metadata/_custom_type_script = "uid://csb55tjjecvsy"

[sub_resource type="Resource" id="Line_prompt"]
script = ExtResource("1_line")
choices = Array[ExtResource("2_choice")]([SubResource("Choice_transmit")])
metadata/_custom_type_script = "uid://cjonbsqr2gwyj"

[sub_resource type="Resource" id="Line_done"]
script = ExtResource("1_line")
metadata/_custom_type_script = "uid://cjonbsqr2gwyj"

[resource]
script = ExtResource("3_dialogue")
lines = Array[ExtResource("1_line")]([SubResource("Line_prompt"), SubResource("Line_done")])
metadata/_custom_type_script = "uid://brjt78ou6p8py"
