# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf
*.png filter=lfs diff=lfs merge=lfs -text
*.avif filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
# One-off: the dog mesh (14 MB). Scoped to this file rather than *.obj so the four small .obj files that are
# already tracked as plain blobs are not re-filtered (a pattern change would make them read as modified).
assets/models/weirdlittleclayguy.obj filter=lfs diff=lfs merge=lfs -text
